4:["$","$Lf",null,{"project":{"slug":"school-erp-igs","title":"School ERP — IGS","tagline":"Zero-to-one governance system for school institutions","description":"As a founding team member at Edpi Innovate, led product discovery and delivery for an Institutional Governance System (IGS) — a core module of an all-in-one school ERP. Ran competitive analysis, defined roadmap priorities, and shipped AI chatbot + global search.","period":"2025 – 2026","status":"Shipped","tags":["0-to-1","EdTech","ERP","AI Chatbot"],"color":"#10b981","gradient":"from-emerald-400 to-teal-500","metrics":[{"value":"0→1","label":"Product Built"},{"value":"2","label":"Core Features Shipped"},{"value":"↓","label":"Admin Effort"}],"tools":["React","Next.js","TypeScript","Claude API","Figma","Jira"],"prd":{"problem":"School administrators manage governance tasks (compliance, approvals, document management) across 5+ disconnected tools, leading to data silos, missed deadlines, and poor visibility into institutional health.","users":[{"persona":"School Administrators","pain":"Fragmented tools, manual processes, no single source of truth"},{"persona":"Teachers","pain":"Difficulty finding relevant governance documents and approvals"},{"persona":"School Leadership","pain":"No real-time dashboard for institutional compliance and task status"}],"solution":"A unified Institutional Governance System with AI-powered search, conversational chatbot for task navigation, and streamlined onboarding workflows — all integrated into the school ERP.","goals":["Reduce administrator task discovery time by 50%","Achieve 90% onboarding completion rate for new schools","Cut manual data entry effort by 40%"],"features":[{"name":"AI Chatbot","description":"Conversational interface built with React/Next.js integrating backend AI models for dynamic workflow navigation"},{"name":"Global Search","description":"Instant filtering with contextual navigation improving task discovery across all modules"},{"name":"Voice-to-Chat","description":"Voice input integration reducing manual administrator data entry"},{"name":"Interactive Data Tables","description":"Sortable, filterable tables with attachment viewer for governance documents"},{"name":"Onboarding Flows","description":"Step-by-step school onboarding with progress tracking and validation"}],"outcomes":"Shipped AI chatbot and global search on schedule as a founding team member. Voice-to-chat integration reduced manual administrator effort. Competitive analysis translated directly into roadmap differentiation for the early-stage product."}}}]
