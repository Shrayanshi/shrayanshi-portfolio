0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"project":{"slug":"ai-question-builder","title":"AI Question Builder","tagline":"AI-powered question generation for classrooms","description":"Designed and shipped an AI question-generation tool adopted by 4 local schools. Ran user feedback loops with teachers and administrators, iterated on classroom usage data, and actively managed the roadmap for 2026 expansion.","period":"Nov 2025 – Feb 2026","status":"Live","tags":["AI Product","EdTech","Roadmapping","User Research"],"color":"#6366f1","gradient":"from-indigo-500 to-purple-600","metrics":[{"value":"4","label":"Schools Adopted"},{"value":"3","label":"Feedback Iterations"},{"value":"2026","label":"Roadmap Active"}],"tools":["Claude Code","Cursor","Figma AI","Gemini","React","Next.js"],"prd":{"problem":"Teachers spend 3–5 hours per week manually creating assessments. Existing tools are generic and don't align to curriculum objectives, forcing extra editing work.","users":[{"persona":"Classroom Teachers","pain":"Time-consuming question creation not aligned to syllabus"},{"persona":"School Administrators","pain":"No visibility into assessment quality or coverage gaps"},{"persona":"Students","pain":"Repetitive, low-quality questions that don't test deep understanding"}],"solution":"An AI-native tool that generates curriculum-aligned questions from uploaded lesson content in seconds, with teacher-in-the-loop editing, difficulty controls, and export to popular formats.","goals":["Reduce assessment creation time by 70%","Achieve 80% teacher satisfaction rate within 3 months","Expand to 20 schools by end of 2026"],"features":[{"name":"Upload & Parse","description":"Upload PDFs, slides, or paste content; AI parses and extracts key concepts"},{"name":"Smart Generation","description":"Generate MCQ, short answer, and essay questions with adjustable difficulty"},{"name":"Curriculum Alignment","description":"Tag questions to learning objectives and Bloom's taxonomy levels"},{"name":"Analytics Dashboard","description":"Track question usage, teacher edits, and coverage gaps (roadmap)"},{"name":"Multi-format Export","description":"Export to Google Forms, Word, and PDF (roadmap)"}],"outcomes":"Adopted by 4 local schools, with positive feedback from teachers citing significant time savings. Roadmap for 2026 includes analytics dashboard, curriculum alignment scoring, and multi-format export."}}}],[["$","script","script-0",{"src":"/_next/static/chunks/08vedo1h1vu93.js","async":true}],["$","script","script-1",{"src":"/_next/static/chunks/06dq3vhldhe3x.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"Qt7WEsCGycBYs0a6sDNB6"}
