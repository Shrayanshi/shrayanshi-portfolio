0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"project":{"slug":"flebo-ai-reports","title":"Flebo AI Reports","tagline":"ML-driven health insights for 6000+ pincodes","description":"Led the AI Reports feature end-to-end at SpiceJet's healthcare platform — from concept through launch. Integrated ML-driven health insights into the patient frontend, enabling personalized test result analysis and doctor recommendations.","period":"2024 – 2025","status":"Shipped","tags":["AI PM","HealthTech","ML Integration","Cross-functional"],"color":"#f59e0b","gradient":"from-amber-400 to-orange-500","metrics":[{"value":"120+","label":"Lab Partners"},{"value":"6000+","label":"Pincodes"},{"value":"↑","label":"Booking Conversion"}],"tools":["React","Redux","SCSS","REST APIs","Figma"],"prd":{"problem":"Patients receiving lab results had no context to understand their health data. 60%+ of post-test calls were basic interpretation questions, overwhelming the support team and reducing platform NPS.","users":[{"persona":"Patients","pain":"Confusing lab results with no actionable guidance"},{"persona":"Support Team","pain":"High volume of post-result interpretation calls"},{"persona":"Doctors","pain":"Patients arriving for consultations without context on their results"}],"solution":"Integrate ML-powered health insights directly into the patient's result view — surfacing plain-language summaries, trend analysis, and personalized doctor recommendations based on result patterns.","goals":["Reduce post-result support calls by 30%","Increase patient satisfaction score for result experience","Drive 15% increase in follow-up consultation bookings"],"features":[{"name":"Plain-language Summaries","description":"AI converts complex lab values into patient-friendly explanations"},{"name":"Trend Analysis","description":"Compare current results against past tests to show trajectory"},{"name":"Doctor Recommendations","description":"Suggest relevant specialists based on flagged biomarkers"},{"name":